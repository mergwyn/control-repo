{
  "lsp": {
    "puppet-languageserver": {
      "binary": {
        "path": "pdk",
        "arguments": ["bundle", "exec", "puppet-languageserver", "--stdio"],
      },
    },
    "solargraph": {
      "binary": {
        "path": "/usr/local/bin/solargraph",
        "arguments": ["stdio"],
      },
    },
  },
  "languages": {
    "Puppet": {
      "language_servers": ["puppet-languageserver"],
    },
    "Ruby": {
      "language_servers": ["solargraph"],
    },
  },
}
