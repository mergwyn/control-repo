{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:best-practices",
    "schedule:weekly",
    ":automergePatch",
  ],

  timezone: "Europe/London",

  ignorePaths: [
    "Gemfile",
    ".devcontainer/**",
  ],

  enabledManagers: [
    "puppet",
    "regex",
  ],

  internalChecksFilter: "strict",

  major: { minimumReleaseAge: "21 days" },
  minor: { minimumReleaseAge: "8 days" },
  patch: { minimumReleaseAge: "3 days" },

  packageRules: [
    {
      matchManagers: ["ruby-version"],
      enabled: false,
    },
    {
      matchPackageNames: ["ruby"],
      enabled: false,
    },
  ],

  regexManagers: [
    {
      // Match all Puppet manifests under profile::app
      fileMatch: [
        "site-modules/profile/manifests/.*\\.pp$",
      ],

      // Match:
      //   String $version = '1.2.3'
      matchStrings: [
        "String\\s+\\$version\\s*=\\s*'(?<currentValue>[^']+)'",
      ],

      // These are defaults — normally overridden by inline comments
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
    },
  ],
}