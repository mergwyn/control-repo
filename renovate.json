{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "baseBranches": ["production"],

  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":automergePatch"
  ],

  "timezone": "Europe/London",

  "ignorePaths": [
    "Gemfile",
    ".devcontainer/**"
  ],

  "enabledManagers": [
    "puppet",
    "regex"
  ],

  "internalChecksFilter": "strict",

  "major": { "minimumReleaseAge": "21 days" },
  "minor": { "minimumReleaseAge": "8 days" },
  "patch": { "minimumReleaseAge": "3 days" },

  "packageRules": [
    {
      "matchManagers": ["ruby-version"],
      "enabled": false
    },
    {
      "matchPackageNames": ["ruby"],
      "enabled": false
    }
  ],

  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["site-modules/profile/manifests/.*\\.pp$"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=(?<depName>[^\\s]+)\\s+\\$\\w+\\s*=\\s*'(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}