{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergePatch",
    "packageRules": [
      {
        "minimumReleaseAge": "3 days",
        "internalChecksFilter": "strict"
      }
    ],
  "major": {
    "minimumReleaseAge": "21 days"
  },
  "minor": {
    "minimumReleaseAge": "8 days"
  },
  "patch": {
    "minimumReleaseAge": "3 days"
  }
}
