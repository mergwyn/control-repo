{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "production"
  ],
  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":automergePatch"
  ],
  "timezone": "Europe/London",
  "ignorePaths": [
    "Gemfile",
    ".devcontainer/**"
  ],
  "enabledManagers": [
    "puppet",
    "custom.regex"
  ],
  "internalChecksFilter": "strict",
  "major": {
    "minimumReleaseAge": "14 days"
  },
  "minor": {
    "minimumReleaseAge": "5 days"
  },
  "patch": {
    "minimumReleaseAge": "3 days"
  },
  "packageRules": [
    {
      "matchManagers": [
        "ruby-version"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ruby"
      ],
      "enabled": false
    },
    {
      "description": "Automerge patch updates for GitHub binaries",
      "matchDatasources": [
        "github-releases"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "matchDatasources": ["github-commits"],
      "groupName": "commit-tracked tools",
      "minimumReleaseAge": "7 days",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/site-modules/profile/manifests/.*\\.pp$/",
        "/hieradata/.*\\.yaml$/",
        "/data/.*\\.yaml$/"
      ],
      "matchStrings": [
        "(?:#|//)\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s+[^=:]*?[=:]\\s*['\"](?<currentValue>[\\w+\\.-]+)['\"]",
        "['\"](?<currentValue>[\\w+\\.-]+)['\"]\\s*,?\\s*(?:#|//)\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
