{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": ["production"],
  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":automergePatch"
  ],
  "timezone": "Europe/London",
  "ignorePaths": [
    "Gemfile",
    ".devcontainer/**"
  ],
  "enabledManagers": [
    "puppet",
    "regex"
  ],
  "internalChecksFilter": "strict",
  "major": { "minimumReleaseAge": "21 days" },
  "minor": { "minimumReleaseAge": "8 days" },
  "patch": { "minimumReleaseAge": "3 days" },
  "packageRules": [
    {
      "matchManagers": ["ruby-version"],
      "enabled": false
    },
    {
      "matchPackageNames": ["ruby"],
      "enabled": false
    },
    {
      "description": "Pin helmfile to 0.x until ready for v1 breaking changes",
      "matchPackageNames": ["helmfile/helmfile"],
      "allowedVersions": "< 1.0.0"
    },
    {
      "description": "Automerge patch updates for GitHub binaries",
      "matchDatasources": ["github-releases"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "site-modules/profile/manifests/.*\\.pp$",
        "hieradata/.*\\.yaml$",
        "data/.*\\.yaml$"
      ],
      "matchStrings": [
        "(?:#|//)\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\s+[\\s\\S]*?[=:]\\s*['\"]?(?<currentValue>[\\w+\\.-]+)['\"]?"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
