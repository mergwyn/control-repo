{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":automergePatch"
  ],

  "timezone": "Europe/London",

  "branchTopic": "{{{depNameSanitized}}}_{{{newMajor}}}{{#if separateMinorPatch}}{{#if isPatch}}.{{{newMinor}}}{{/if}}{{/if}}{{#if separateMultipleMinor}}{{#if isMinor}}.{{{newMinor}}}{{/if}}{{/if}}.x{{#if isLockfileUpdate}}_lockfile{{/if}}",

  "ignorePaths": [
    "Gemfile",
    ".devcontainer/*"
  ],

  "enabledManagers": [
    "puppet",
    "regex"
  ],

  "internalChecksFilter": "strict",

  "major": { "minimumReleaseAge": "21 days" },
  "minor": { "minimumReleaseAge": "8 days" },
  "patch": { "minimumReleaseAge": "3 days" },

  "packageRules": [
    {
      "matchManagers": ["ruby-version"],
      "enabled": false
    },
    {
      "matchPackageNames": ["ruby"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "kubectl",
        "helm",
        "kubectx",
        "kubens",
        "sops",
        "age",
        "argocd",
        "kustomize",
        "velero"
      ],
      "enabled": false
    }
  ],

  "regexManagers": [
    {
      "fileMatch": [
        "site-modules/profile/manifests/.*\\.pp$"
      ],
      "matchStrings": [
        "String\\s+\\$version\\s*=\\s*'(?<currentValue>[^']+)'"
      ],
      "depNameTemplate": "helmfile",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "helmfile/helmfile",
      "versioningTemplate": "semver"
    }
  ]
}
